				"dir /b /ad \"%LOCALAPPDATA%\\Neo4j*\" 2>nul & dir /b /ad \"%APPDATA%\\Neo4j*\" 2>nul & dir /b /ad \"%PROGRAMDATA%\\Neo4j*\" 2>nul & echo SEARCH_DONE"
			],
			"group": "build"
		},
