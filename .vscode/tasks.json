			"label": "Wait and check Neo4j ports",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"timeout /t 10 /nobreak >nul & netstat -an | findstr 7687 & echo --- & netstat -an | findstr 7474 & echo SEARCH_DONE"
			],
			"group": "build"
		},
