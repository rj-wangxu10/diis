			"command": "cmd",
			"args": [
				"/c",
				"dir /b \"C:\\Users\\ruijie\\.Neo4jDesktop2\\Data\\dbmss\\dbms-3670aec1-2071-42a2-b3ee-c97d2e883163\\bin\" 2>nul & echo SEARCH_DONE"
