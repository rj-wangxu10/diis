			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"type \"C:\\Users\\ruijie\\.Neo4jDesktop2\\Data\\dbmss\\dbms-3670aec1-2071-42a2-b3ee-c97d2e883163\\conf\\neo4j.conf\" 2>nul | findstr /i \"bolt http listen address port password\" & echo SEARCH_DONE"
			],
			"group": "build"
		},
		{
			"label": "Read Neo4j config v2",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"type \"C:\\Users\\ruijie\\.Neo4jDesktop2\\Data\\dbmss\\dbms-3670aec1-2071-42a2-b3ee-c97d2e883163\\conf\\neo4j.conf\" 2>nul | findstr /i \"bolt\" & echo --- & type \"C:\\Users\\ruijie\\.Neo4jDesktop2\\Data\\dbmss\\dbms-3670aec1-2071-42a2-b3ee-c97d2e883163\\conf\\neo4j.conf\" 2>nul | findstr /i \"listen\" & echo --- & type \"C:\\Users\\ruijie\\.Neo4jDesktop2\\Data\\dbmss\\dbms-3670aec1-2071-42a2-b3ee-c97d2e883163\\conf\\neo4j.conf\" 2>nul | findstr /i \"7687\" & echo SEARCH_DONE"
			],
			"group": "build"
		},
