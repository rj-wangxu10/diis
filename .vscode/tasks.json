			"label": "List Neo4j Desktop2 contents",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"dir /b /ad \"%USERPROFILE%\\.Neo4jDesktop2\" 2>nul & echo --- & dir /b /ad \"%USERPROFILE%\\.Neo4jDesktop2\\*\" 2>nul & echo SEARCH_DONE"
			],
			"group": "build"
		},
