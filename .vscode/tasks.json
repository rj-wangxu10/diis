			"label": "List Neo4j Desktop LocalAppData",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"dir /b /ad \"%LOCALAPPDATA%\\Neo4j Desktop\" 2>nul & echo --- & dir /b /ad \"%LOCALAPPDATA%\\neo4j-desktop\" 2>nul & echo SEARCH_DONE"
			],
			"group": "build"
		},
