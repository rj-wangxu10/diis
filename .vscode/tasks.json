			"label": "List neo4j-desktop LocalAppData",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"dir /b /ad \"%LOCALAPPDATA%\\neo4j-desktop\" 2>nul & echo --- & dir /b /ad \"%LOCALAPPDATA%\\neo4j-desktop-updater\" 2>nul & echo SEARCH_DONE"
			],
			"group": "build"
		},
