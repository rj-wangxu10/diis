			"label": "List neo4j-desktop files",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"dir /b \"%LOCALAPPDATA%\\neo4j-desktop\" 2>nul & echo --- & dir /b \"%LOCALAPPDATA%\\neo4j-desktop-updater\" 2>nul & echo SEARCH_DONE"
			],
			"group": "build"
		},
		{
			"label": "Check for Neo4j process",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"tasklist /fi \"imagename eq neo4j*\" 2>nul & echo --- & tasklist /fi \"imagename eq java*\" 2>nul | findstr /i java & echo SEARCH_DONE"
			],
			"group": "build"
		},
		{
			"label": "Find Neo4j Desktop exe",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"where /r \"%LOCALAPPDATA%\" Neo4jDesktop.exe 2>nul & where /r \"%LOCALAPPDATA%\" neo4j-desktop.exe 2>nul & where /r \"%APPDATA%\" Neo4jDesktop.exe 2>nul & echo SEARCH_DONE"
			],
			"group": "build"
		},
		{
			"label": "Find Neo4j exe in user dir",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"where /r \"C:\\Users\\ruijie\" Neo4j*.exe 2>nul & echo SEARCH_DONE"
			],
			"group": "build"
		},
		{
			"label": "Launch Neo4j Desktop",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"start \"\" \"C:\\Users\\ruijie\\AppData\\Local\\Programs\\Neo4j Desktop 2\\Neo4j Desktop 2.exe\" & echo NEO4J_DESKTOP_LAUNCHED"
			],
			"isBackground": true,
			"group": "build"
		},
		{
			"label": "Check Neo4j Desktop process",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"tasklist /fi \"imagename eq Neo4j*\" 2>nul & echo --- & tasklist /fi \"imagename eq java*\" 2>nul | findstr /i java & echo SEARCH_DONE"
			],
			"group": "build"
		},
		{
			"label": "Check all processes for Neo4j",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"tasklist 2>nul | findstr /i \"neo4j\" & echo --- & tasklist 2>nul | findstr /i \"java\" & echo SEARCH_DONE"
			],
			"group": "build"
		},
		{
			"label": "Check Neo4j bolt port",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"netstat -an | findstr \"7687 7474\" & echo SEARCH_DONE"
			],
			"group": "build"
		},
