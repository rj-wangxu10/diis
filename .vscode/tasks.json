			"command": "npm",
			"args": [
				"run",
				"dev",
				"--workspace",
				"@datafoundry/api"
			],
			"isBackground": true,
			"group": "build"
		},
		{
			"label": "Start Web Server",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--workspace",
				"@datafoundry/web"
			],
			"isBackground": true,
			"group": "build"
		},
		{
			"label": "Build workspace packages",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Build workspace packages",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Start dev servers (API + Web)",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev"
			],
			"isBackground": true
		},
		{
			"label": "Check Docker availability",
			"type": "shell",
			"command": "cmd",
			"args": [
				"-c",
				"docker --version 2>&1 && echo DOCKER_AVAILABLE || echo DOCKER_NOT_AVAILABLE"
			],
			"group": "build"
		},
		{
			"label": "Check Docker v2",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"docker --version 2>&1 && echo DOCKER_AVAILABLE || echo DOCKER_NOT_AVAILABLE"
			],
			"group": "build"
		},
		{
			"label": "Check Neo4j in PATH",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"where neo4j 2>&1 || echo NEO4J_NOT_IN_PATH"
			],
			"group": "build"
		},
		{
			"label": "Search for Neo4j installation",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"dir /b /s C:\\neo4j* 2>nul | findstr /i neo4j | head -5 || echo NO_NEO4J_FOUND"
			],
			"group": "build"
		},
		{
			"label": "Search for Neo4j installation v2",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"dir /b \"C:\\Program Files\\neo4j*\" 2>nul & dir /b \"C:\\Program Files (x86)\\neo4j*\" 2>nul & dir /b \"D:\\neo4j*\" 2>nul & dir /b \"%USERPROFILE%\\.Neo4j*\" 2>nul & echo SEARCH_DONE"
			],
			"group": "build"
		},
		{
			"label": "Search for Neo4j Desktop",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"dir /b /s \"%USERPROFILE%\\.Neo4jDesktop\" 2>nul | findstr /i \"neo4j.exe neo4j.bat neo4j.ps1\" 2>nul & echo SEARCH_DONE"
			],
			"group": "build"
		},
		{
			"label": "Search for Neo4j Desktop2",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"dir /b /s \"%USERPROFILE%\\.Neo4jDesktop2\" 2>nul | findstr /i \"neo4j.exe neo4j.bat neo4j.ps1 installations\" 2>nul & echo SEARCH_DONE"
			],
			"group": "build"
		},
		{
			"label": "Search for Neo4j Desktop installations",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"dir /b /s \"%USERPROFILE%\\.Neo4jDesktop2\\installations\" 2>nul & echo SEARCH_DONE"
			],
			"group": "build"
		},
